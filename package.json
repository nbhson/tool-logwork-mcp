{
  "name": "s-tempo-worklog-mcp",
  "version": "0.4.0",
  "description": "Tempo Timesheet MCP Server - integrates Tempo Timesheets and Jira Cloud with MCP clients such as OpenCode",
  "type": "module",
  "license": "MIT",
  "author": "nbhson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbhson/tool-logwork-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nbhson/tool-logwork-mcp/issues"
  },
  "homepage": "https://github.com/nbhson/tool-logwork-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tempo",
    "timesheet",
    "worklog",
    "jira",
    "opencode",
    "ai-agent",
    "time-tracking"
  ],
  "files": [
    "dist",
    ".opencode",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "tempo-worklog-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run typecheck:test && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
