# Tempo Timesheet MCP Server - environment configuration
# Copy this file to .env and fill in your values. NEVER commit the real .env file.

# ---- Tempo (required for all tempo_* tools) ----
# Create a token in Tempo: Settings > Data Access > API Integration > New Token
# Minimum scope needed: Worklogs (View; also Manage if you enable WORKLOG_WRITE_ENABLED=true)
TEMPO_API_TOKEN=
TEMPO_BASE_URL=https://api.tempo.io

# ---- Jira (required for issue resolution and search) ----
# JIRA_BASE_URL is your site root, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---- General ----
# debug | info | warn | error
LOG_LEVEL=info

# IANA timezone used to resolve "today" and week boundaries, e.g. Asia/Ho_Chi_Minh
# Empty value falls back to the system timezone.
DEFAULT_TIMEZONE=

# ---- Safety ----
# Master switch for write operations (create/update worklog).
# Keep false until you explicitly want to allow writes.
WORKLOG_WRITE_ENABLED=false
